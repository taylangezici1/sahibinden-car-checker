{
  "manifest_version": 3,
  "name": "Sahibinden Car Checker",
  "version": "0.1.0",
  "description": "Personal used-car listing checker for sahibinden.com",
  "permissions": ["storage"],
  "host_permissions": ["https://www.sahibinden.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sahibinden.com/ilan/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sahibinden Car Checker",
    "default_popup": "popup/popup.html"
  }
}
